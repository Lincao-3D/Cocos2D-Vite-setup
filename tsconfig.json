{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    
    "baseUrl": "./",
    "paths": {
      "@scripts/*": ["src/scripts/*"]
    },

    "types": ["vite/client"],
    "skipLibCheck": true,

/* --- ADICIONE/ALTERE ESTAS LINHAS --- */
    "experimentalDecorators": true,        // OBRIGATÓRIO para @ccclass
    "emitDecoratorMetadata": true,         // OBRIGATÓRIO para o Cocos entender os tipos
    // MUDE PARA FALSE (Decorators não são apenas 'apagáveis')
    /* ------------------------------------ */


    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": false,

    "noImplicitAny": false,
  },
  "include": ["src", "src/**/*.d.ts"]
}
